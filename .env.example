# Copy to .env. Every value has a working default, so an empty .env is fine.

# APP_NAME=My Project
# APP_ICON=📦

# Where data lives (relative paths resolve from the repo root).
# RAW_DIR=02_data/raw
# TABLES_DIR=02_data/tables

# What the pipeline WRITES: csv, parquet or xlsx. Reading always accepts all
# three, so you can drop any of them into 02_data/raw/ regardless.
#   csv      opens anywhere, biggest files
#   parquet  ~3x smaller and faster, keeps dtypes — best once data grows
#   xlsx     only when a human needs to open it in Excel
# FILE_FORMAT=csv


# ══════════════════════════════════════════════════════════════════════════════
#  Google Cloud Storage — optional, off by default
# ══════════════════════════════════════════════════════════════════════════════
# GCS_BUCKET and GCS_UPLOAD are TWO SEPARATE SWITCHES. One controls reading,
# the other controls writing. Setting one does not imply the other:
#
#   GCS_BUCKET   GCS_UPLOAD   what happens
#   ──────────   ──────────   ──────────────────────────────────────────────────
#   (empty)      false        Everything local. The pipeline writes
#                             02_data/tables/ and the app reads it back.
#                             This is the default.
#
#   set          false        The APP READS THE BUCKET. The pipeline still only
#                             writes locally. Use when something else fills the
#                             bucket — a scheduled job, a teammate, CI.
#
#   set          true         The full loop. `make pipeline` writes locally AND
#                             uploads each table; the app reads the bucket.
#
#   (empty)      true         Error: "GCS_UPLOAD is on but GCS_BUCKET is empty."
#                             Raised immediately rather than silently skipped.
#
# ⚠️  Setting GCS_BUCKET alone flips the app to remote reads straight away. If
#     nothing has been uploaded yet the dashboard goes blank — it has stopped
#     looking at your local 02_data/tables/. Usually you want both set together.

# The bucket the app reads from. Empty = stay entirely local.
GCS_BUCKET=

# Optional sub-path inside the bucket, e.g. "dashboards/sales".
# Empty = objects sit at the bucket root.
GCS_PREFIX=

# Your GCP project id. Optional for reading and writing objects in an existing
# bucket; set it to silence a gcsfs warning.
GCS_PROJECT=

# Path to the service-account JSON key you downloaded from Google Cloud.
# Leave empty until you actually have one. Drop the file in the repo root and
# put its name here, e.g. GCS_KEY_FILE=cloud-key.json — every *.json is
# gitignored, so it cannot be committed by accident.
#
# Credentials are tried in order, first hit wins:
#   1. this key file          (local development)
#   2. [connections.gcs] in .streamlit/secrets.toml   (deployment)
#   3. Application Default Credentials  (Cloud Run, GCE, Workload Identity)
GCS_KEY_FILE=

# true = `make pipeline` uploads every table after writing it locally.
# Local files are always written first, so a failed upload never loses data.
# Read from the environment only, never from secrets — a deployed app therefore
# cannot start writing to your bucket by accident.
GCS_UPLOAD=false

# A deployed app has no .env. Put GCS_BUCKET (and GCS_PREFIX) plus the
# [connections.gcs] credential block in Streamlit secrets instead —
# see .streamlit/secrets.example.toml.
#
# If credentials are wrong, READS FAIL SILENTLY: tables come back empty and
# pages show their empty state rather than crashing. A blank dashboard is the
# symptom — the home page tells you whether it was an auth failure or an empty
# bucket. WRITES do raise, so a broken upload stops the pipeline loudly.
